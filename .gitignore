# The root repository tracks only the source submodules, the procurement
# document, dev docs/scripts, and test fixtures. Keep all other existing
# directories/files on disk without adding them to Git.
/*

# Root repository metadata and explicitly tracked content.
!/.gitignore
!/数据沙箱系统开发文档.md
!/xzh功能测试文档.md
!/谈判采购文件.pdf
!/test/
!/test/**
!/secretpad/
!/secretpad-frontend/
!/技术响应.docx

# zgz dev docs & scripts（数据沙箱系统开发文档.md 之上）
!/claude/
!/claude/**
!/scripts/
!/scripts/**
# 运行期日志/pid 不入库
/scripts/logs/

# 本地运行期/缓存/凭据 —— 禁止入库（public 仓库）
/.dev-runtime/
/.cache/
/.claude/
/*.deb
